
# ==========================================
# Dependencies
# ==========================================
node_modules/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example
!.env.sample

*.pem
*.key
*.p12
*.pfx

# ==========================================
# Logs
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Runtime & Temporary Files
# ==========================================
tmp/
temp/
.cache/
*.pid
*.pid.lock

# ==========================================
# Build & Test Outputs
# ==========================================
dist/
build/
coverage/
.nyc_output/

# ==========================================
# Prisma
# ==========================================
# Keep Prisma schema and migrations tracked.
# Ignore local database files.
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# ==========================================
# Application Storage
# ==========================================
# Ignore runtime uploads and generated files.
# Keep storage directory structure if needed.
storage/*
!storage/.gitkeep

# ==========================================
# IDE & Editor
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ==========================================
# Operating System
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Local Backups
# ==========================================
*.bak
*.backup
*.old
backups/
